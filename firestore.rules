rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ahmadwaqas88095@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'published']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        data.published is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('drive_url' in data) || (data.drive_url is string && data.drive_url.size() <= 2048)) &&
        (!('cover_image' in data) || (data.cover_image is string && data.cover_image.size() <= 2048));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'note_id', 'amount', 'customer_name', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.note_id is string && data.note_id.size() <= 128 &&
        data.amount is number && data.amount >= 0 &&
        data.customer_name is string && data.customer_name.size() > 0 && data.customer_name.size() <= 150 &&
        data.status in ['pending', 'paid', 'initiated', 'pending_verification', 'approved', 'rejected'] &&
        (!('customer_email' in data) || (data.customer_email is string && data.customer_email.size() <= 200)) &&
        (!('customer_phone' in data) || (data.customer_phone is string && data.customer_phone.size() <= 30)) &&
        (!('utr_number' in data) || (data.utr_number is string && data.utr_number.size() <= 64));
    }

    // Educational Notes Collection
    match /notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create, update: if isValidId(noteId) && (isAdmin() || isValidNote(incoming()));
      allow delete: if isValidId(noteId) && (isAdmin() || true);
    }

    // Student Purchase Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create, update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Public Store Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId);
    }

    // Permanent Note Cover & Inside Preview Images
    match /note_images/{imageId} {
      allow get: if isValidId(imageId);
      allow list: if true;
      allow create, update: if isValidId(imageId);
      allow delete: if isValidId(imageId);
    }

    // Admin authorization collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Provisioned strictly via server-side admin
    }
  }
}
