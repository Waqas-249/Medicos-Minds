# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: PIN or password to access the private Creator/Admin panel (default is 1234)
ADMIN_PASSWORD="1234"

# Optional: Cashfree Payments (Legitimate Indian UPI Merchant Gateway)
# Deposits directly into your bank account; supports automatic server-side UPI status verification and webhooks.
# Sign up at https://www.cashfree.com/ to get your Merchant App ID and Secret Key.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="TEST"
CASHFREE_WEBHOOK_SECRET=""

# Supabase Backend & Database Configuration
# Project URL or Project Reference ID (e.g. nbfeocwwotjqwdhwhiyy or https://nbfeocwwotjqwdhwhiyy.supabase.co)
SUPABASE_URL="https://nbfeocwwotjqwdhwhiyy.supabase.co"
# Supabase API Key: Service Role Secret Key (for full backend admin access) or Publishable/Anon Key
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

